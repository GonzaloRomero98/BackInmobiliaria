PORT=3001

# JWT: secreto aleatorio de al menos 32 caracteres (p. ej. `openssl rand -hex 32`)
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Base de datos PostgreSQL
DB_HOST=
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_NAME=
# TLS: verifica el certificado del servidor con la CA de AWS RDS (certs/rds-global-bundle.pem)
# DB_SSL=false                      # solo para un Postgres local sin TLS
# DB_SSL_CA=/ruta/a/otra-ca.pem     # otra CA
# DB_SSL_REJECT_UNAUTHORIZED=false  # NO recomendado: desactiva la verificación del certificado
# Esquema: migraciones automáticas al iniciar; synchronize solo en BD desechables
DB_SYNCHRONIZE=false
DB_MIGRATIONS_RUN=true

# AWS S3. En EC2 se recomienda NO definir las claves y usar el rol IAM de la instancia.
AWS_REGION=us-east-1
AWS_S3_BUCKET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# HTTP
CORS_ORIGINS=http://localhost:3000
# TRUST_PROXY=1     # si la API está detrás de un balanceador o proxy inverso
# SWAGGER=false     # desactiva la documentación en /api/docs

# Datos personales: días que se conservan las solicitudes antes de borrarse
SOLICITUD_RETENCION_DIAS=365

# Solo para `npm run seed:roles` (crear el primer ADMIN); bórralos después
# ADMIN_CORREO=
# ADMIN_CONTRASENA=
# ADMIN_NOMBRE=
